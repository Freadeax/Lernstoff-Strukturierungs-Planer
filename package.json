{
  "name": "lernstoff-planer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modularer Lernstoff-Planer mit quellengetreuen Zusammenfassungen, zuerst für die generalistische Pflegeausbildung",
  "scripts": {
    "dev": "vite --host",
