{
  "name": "lernstoff-planer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modularer Lernstoff-Planer mit quellengetreuen Zusammenfassungen, zuerst für die generalistische Pflegeausbildung",
  "scripts": {
    "predev": "node scripts/copy-tesseract.mjs",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:ui": "node scripts/check-ui.mjs",
    "typecheck": "tsc -b --noEmit",
    "test:material": "node scripts/check-material.mjs",
    "test:wissen": "node scripts/check-wissensstand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "dexie": "^4.4.7",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/deu": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
