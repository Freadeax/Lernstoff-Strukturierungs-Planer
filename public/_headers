# Sicherheitsheader für Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# GitHub Pages ignoriert diese Datei. Geprüft mit scripts/check-csp.mjs (Teil von npm run check):
# alle Seiten, PDF mit Scan-Seite (pdf.js-Worker + Tesseract-WASM im Blob-Worker), PWA, ohne CSP-Verstoß.
#
# Erlaubte Verbindungen: nur die eigene Adresse, die Claude-API (KI-Funktionen mit eigenem Schlüssel)
# und die GitHub-API (private Material-Ablage). Neue Dienste hier UND in scripts/check-csp.mjs eintragen.
#
# Berechtigungen (Permissions-Policy): nur das Mikrofon ist für die eigene Adresse erlaubt. Es wird gebraucht für
# die mündliche Prüfung (src/features/examen/Muendlich.tsx, Aufnahme per MediaRecorder) und das Diktat in der
# Übergabe (src/features/uebergabe/diktat.ts, Web Speech API). Der Browser fragt trotzdem jedes Mal nach.
# Die Kamera nutzt die App nicht (Fotos kommen über die Dateiauswahl, QR-Codes werden nur angezeigt), deshalb camera=().
# Braucht eine neue Funktion eine Berechtigung, hier begründen und in scripts/check-csp.mjs mitprüfen.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' blob: data: https://api.anthropic.com https://api.github.com https://uploads.github.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Service Worker, Manifest, Startseite und Versionsdatei immer frisch holen, damit Updates ankommen
# (src/ui/shell/aktualisierung.ts fragt version.json ab; GitHub Pages ignoriert diese Datei, dort hilft
# der Anfrageparameter und cache: 'no-store' in der App).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Gebündelte Dateien tragen einen Hash im Namen und ändern sich nie
/assets/*
  Cache-Control: public, max-age=31536000, immutable
