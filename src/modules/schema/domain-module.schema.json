{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernstoff-planer.local/schema/domain-module.schema.json",
  "title": "DomainModule",
  "description": "Fachneutrales Fachmodul des Lernstoff-Planers. Kernfelder entsprechen core-contract/types.ts; frameworks, references, operators und examFormats sind optionale Erweiterungen. Gilt für Pflege ebenso wie für jedes andere Fachgebiet.",
  "type": "object",
  "required": ["id", "name", "version", "subjects", "topics", "glossary", "taskFormats", "checkRules"],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sprache": { "type": "string" },
    "stand": { "type": "string", "format": "date" },
    "rechtsgrundlagen": { "$ref": "#/$defs/idList" },
    "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "topics": { "type": "array", "items": { "$ref": "#/$defs/topic" } },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/glossaryEntry" } },
    "taskFormats": { "type": "array", "items": { "$ref": "#/$defs/taskFormat" } },
    "checkRules": { "type": "array", "items": { "$ref": "#/$defs/checkRule" } },
    "frameworks": { "type": "array", "items": { "$ref": "#/$defs/framework" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "operators": { "type": "array", "items": { "$ref": "#/$defs/operator" } },
    "examFormats": { "type": "array", "items": { "$ref": "#/$defs/examFormat" } },
    "drugProfiles": { "type": "array", "items": { "$ref": "#/$defs/drugProfile" } },
    "diseaseProfiles": { "type": "array", "items": { "$ref": "#/$defs/diseaseProfile" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]+(\\.[A-Za-z0-9-]+)+$", "description": "Stabile Präfix-ID, z. B. thema.pflege.dekubitus" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "pruefstatus": { "enum": ["ungeprueft", "geprueft", "veraltet"], "description": "Ob Katalogangaben gegen das Original (Normtext, Standard) geprüft wurden." },

    "subject": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "moduleId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "additionalProperties": false
    },

    "topic": {
      "type": "object",
      "required": ["id", "subjectId", "name", "prerequisites"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "prerequisites": { "$ref": "#/$defs/idList" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "competencyIds": { "$ref": "#/$defs/idList" },
        "referenceIds": { "$ref": "#/$defs/idList" },
        "taskFormatIds": { "$ref": "#/$defs/idList" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "glossaryEntry": {
      "type": "object",
      "required": ["term", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "term": { "type": "string" },
        "abbreviation": { "type": "string" },
        "definition": { "type": "string" },
        "citation": { "type": "object" },
        "topicIds": { "$ref": "#/$defs/idList" },
        "synonyms": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" },
        "origin": { "enum": ["katalog", "quelle"], "description": "katalog = ergänzendes Wissen ohne Beleg im Nutzermaterial" }
      },
      "additionalProperties": false
    },

    "taskFormat": {
      "type": "object",
      "required": ["id", "name", "description", "requiredParts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "requiredParts": { "type": "array", "items": { "type": "string" } },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "required"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean" },
              "hint": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "referenceIds": { "$ref": "#/$defs/idList" },
        "checkRuleIds": { "$ref": "#/$defs/idList" }
      },
      "additionalProperties": false
    },

    "checkRule": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "severity": { "enum": ["fehler", "warnung", "hinweis"] },
        "method": { "enum": ["struktur", "llm", "abgleich"] },
        "scope": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "framework": {
      "type": "object",
      "required": ["id", "name", "kind", "items"],
      "description": "Kompetenzrahmen oder Curriculum, auf das Themen, Lernziele und Prüfungen verweisen.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["kompetenzen", "curriculum", "lernziele"] },
        "referenceIds": { "$ref": "#/$defs/idList" },
        "pruefstatus": { "$ref": "#/$defs/pruefstatus" },
        "hinweis": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "code", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "parentId": { "$ref": "#/$defs/id" },
              "code": { "type": "string" },
              "name": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "reference": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "description": "Wissensobjekt mit eigener Identität: Rechtsnorm, Fachstandard, Assessment, Modell, Klassifikation.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["norm", "standard", "assessment", "modell", "klassifikation", "leitlinie"] },
        "name": { "type": "string" },
        "details": { "type": "string" },
        "url": { "type": "string" },
        "pruefstatus": { "$ref": "#/$defs/pruefstatus" }
      },
      "additionalProperties": false
    },

    "drugProfile": {
      "type": "object",
      "required": ["id", "substance", "drugClass", "mechanism", "indications", "adverseEffects", "nursing", "topicIds", "sources"],
      "description": "Arzneimittel-Steckbrief: Wirkstoff, Gruppe, Wirkprinzip, Anwendung, Nebenwirkungen, Pflegerelevanz, mit Quellen.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "substance": { "type": "string", "minLength": 1 },
        "abbreviation": { "type": "string" },
        "brandNames": { "type": "array", "items": { "type": "string" } },
        "drugClass": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "indications": { "$ref": "#/$defs/textList" },
        "adverseEffects": { "$ref": "#/$defs/textList" },
        "contraindications": { "$ref": "#/$defs/textList" },
        "nursing": { "$ref": "#/$defs/textList" },
        "mnemonic": { "type": "string" },
        "antidote": { "type": "string" },
        "topicIds": { "$ref": "#/$defs/idList" },
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["title", "url"],
            "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } },
            "additionalProperties": false
          }
        },
        "pruefstatus": { "$ref": "#/$defs/pruefstatus" }
      },
      "additionalProperties": false
    },
    "diseaseSection": { "enum": ["definition", "formen", "ursachen", "risikofaktoren", "symptome", "komplikationen", "diagnostik", "therapie", "pflege", "beratung", "prophylaxen"] },
    "diseaseProfile": {
      "type": "object",
      "required": ["id", "name", "definition", "ursachen", "symptome", "pflege", "topicIds"],
      "description": "Krankheitsbild-Steckbrief. Abschnitte mit Beleg stammen vollständig aus dem Unterrichtsmaterial, der Rest ist ungeprüftes Katalogwissen.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "synonyms": { "type": "array", "items": { "type": "string" } },
        "definition": { "type": "string", "minLength": 1 },
        "formen": { "$ref": "#/$defs/textList" },
        "ursachen": { "$ref": "#/$defs/textList" },
        "risikofaktoren": { "$ref": "#/$defs/textList" },
        "symptome": { "$ref": "#/$defs/textList" },
        "komplikationen": { "$ref": "#/$defs/textList" },
        "diagnostik": { "$ref": "#/$defs/textList" },
        "therapie": { "$ref": "#/$defs/textList" },
        "pflege": { "$ref": "#/$defs/textList" },
        "beratung": { "$ref": "#/$defs/textList" },
        "prophylaxen": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["topicId", "grund"],
            "properties": { "topicId": { "$ref": "#/$defs/id" }, "grund": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "merksatz": { "type": "string" },
        "drugIds": { "$ref": "#/$defs/idList" },
        "assessmentIds": { "$ref": "#/$defs/idList" },
        "referenceIds": { "$ref": "#/$defs/idList" },
        "topicIds": { "$ref": "#/$defs/idList", "minItems": 1 },
        "belege": {
          "type": "array",
          "items": {
            "type": "object", "required": ["abschnitt", "quelle", "seiten"],
            "properties": {
              "abschnitt": { "$ref": "#/$defs/diseaseSection" },
              "quelle": { "type": "string", "minLength": 1 },
              "seiten": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "pruefstatus": { "$ref": "#/$defs/pruefstatus" }
      },
      "additionalProperties": false
    },
    "textList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },

    "operator": {
      "type": "object",
      "required": ["id", "name", "afb", "expects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "afb": { "type": "integer", "enum": [1, 2, 3], "description": "Anforderungsbereich I-III" },
        "expects": { "type": "string" }
      },
      "additionalProperties": false
    },

    "examFormat": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["schriftlich", "muendlich", "praktisch", "gemischt"] },
        "details": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "competencyIds": { "$ref": "#/$defs/idList" },
        "taskFormatIds": { "$ref": "#/$defs/idList" },
        "referenceIds": { "$ref": "#/$defs/idList" },
        "pruefstatus": { "$ref": "#/$defs/pruefstatus" }
      },
      "additionalProperties": false
    }
  }
}
